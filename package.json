{
  "name": "creatorsai",
  "version": "0.12.0",
  "private": true,
  "description": "CreatorsAI \u2014 the Creator Growth Network. Stage 1 Foundation + Stage 2 Deal Desk & Campaigns + v0.3 Revenue & Retention \u00b7 v0.8 Setup check \u00b7 v0.9 Free tools, guides, AdSense & interactions.",
  "author": "Kartikeya Mishra",
