    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-creatorsai \"vitest run --config vitest.rules.config.mts\"",
    "verify": "npm run typecheck && npm run test && npm run build",
    "set-admin": "node scripts/set-admin.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/check-repo.mjs",
    "check-repo": "node scripts/check-repo.mjs",
    "create-test-user": "node scripts/create-test-user.mjs"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "geist": "^1.9.2",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
