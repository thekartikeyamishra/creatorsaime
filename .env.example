# ─────────────────────────────────────────────────────────────
# CreatorsAI — environment template. Copy to .env.local (never commit it).
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG, invite links, Origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://creatorsai.me

# Firebase Web SDK config (Firebase console → Project settings → Your apps → Web app).
# These are public identifiers, not secrets. Security comes from Firestore rules + server checks.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (SERVER ONLY — keep in your host's secret manager).
# Option A (recommended on Google Cloud / Firebase App Hosting): leave blank, Application Default Credentials are used.
# Option B (Vercel / elsewhere): paste the service-account JSON, base64-encoded:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Secret used to salt IP / email hashes for rate limiting and dedupe (32+ random chars).
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
HASH_SALT=

# Grievance officer contact shown on legal pages (DPDP / IT Rules).
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Optional: Google Search Console verification token (meta tag content only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Payments (Razorpay) — server only ───────────────────────
# Dashboard → Account & Settings → API Keys. Use test keys (rzp_test_…) until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://creatorsai.me/api/plans/webhook with events order.paid, payment.captured
RAZORPAY_WEBHOOK_SECRET=

# ─── Notifications ──────────────────────────────────────────
# Daily digest job (Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically).
CRON_SECRET=
# Optional email delivery via Resend (https://resend.com). Leave blank for in-app only.
RESEND_API_KEY=
EMAIL_FROM="CreatorsAI <hello@creatorsai.me>"

# ─── WhatsApp Business (Meta Cloud API) — server only ───────
# developers.facebook.com → your app → WhatsApp → API Setup. Use a permanent System User token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App → Settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string; enter the same value when configuring the webhook URL https://creatorsai.me/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
# Optional template overrides (defaults: cai_otp, cai_daily_digest, cai_new_activity, cai_payment_reminder) and language
WA_TEMPLATE_LANG=en

# ─── Google AdSense (ads only on /tools and /guides) ────────
# Publisher ID (also used for the site-verification meta tag and must match public/ads.txt)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4557897331416844
# Set to false to switch every ad off instantly (redeploy).
NEXT_PUBLIC_ADS_ENABLED=true
# Ad unit IDs (numbers) — create after approval: AdSense → Ads → By ad unit. Empty = that placement shows nothing.
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX=
